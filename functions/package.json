{
  "name": "strategy-game-functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "verify": "npm run build && npm run verify:outcome && npm run verify:pvp && npm run verify:judge",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint --ext .ts .",
    "verify:outcome": "node scripts/verify-outcome.js",
    "verify:pvp": "node scripts/verify-pvp-trigger.js",
    "verify:judge": "node scripts/verify-pvp-judge.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@google/generative-ai": "^0.21.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "google-auth-library": "^9.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "firebase-functions-test": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "private": true
}
